# Copy this file to .env and fill in your own values.
# .env is git ignored, so nothing here reaches the repository.

# Needed by 01-cloud-urban-gis/src/analysis/mapbox_isochrone.py to call the
# Mapbox Isochrone API. Create a free public token at
# https://account.mapbox.com/access-tokens/ and restrict it to your own domains.
MAPBOX_ACCESS_TOKEN=pk.your_public_token_here
